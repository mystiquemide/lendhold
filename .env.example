# Binance Web3 API (server only). Get a key at https://web3.binance.com/en/dev-portal
BINANCE_WEB3_API_KEY=
BINANCE_WEB3_API_SECRET=

# BSC RPC used for on-chain reads
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org

# Lista Lending
LISTA_API_BASE=https://api.lista.org
LISTA_MOOLAH_ADDRESS=0x8F73b65B4caAf64FBA2aF91cC5D4a2A1318E5D8C

# Agent path (server only)
OPERATOR_TOKEN=
AGENT_MAX_USD_PER_RUN=50
BAW_BIN=baw

# Plain-language entry (server only, optional)
OPENAI_API_KEY=
OPENAI_MODEL=

# Browser wallet (optional, enables WalletConnect QR)
NEXT_PUBLIC_WC_PROJECT_ID=

# Run store
DATABASE_PATH=./data/lendhold.db
